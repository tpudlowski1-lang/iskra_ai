# Copy these keys into the hosting provider's Environment settings.
# Never commit real credentials or a populated .env file.

PORT=10000
# Point DATA_DIR at a persistent mounted disk, not the container's ephemeral filesystem.
DATA_DIR=/var/data

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
API_TOKEN=replace-with-a-long-random-secret

LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDERS=openai,gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional and disabled by default. Enabling sends document chunks and queries to OpenAI.
ENABLE_SEMANTIC_SEARCH=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Memory storage is per process. Use a shared Redis URL for multiple workers/instances.
RATELIMIT_STORAGE_URI=memory://

# Keep disabled on multi-worker hosting until the loop has a single-leader design.
ENABLE_AUTONOMOUS_LOOP=false
